@model u24637646_HW03.ViewModels.ProductViewModel

@{
    ViewBag.Title = "Delete";
}

<link href="~/Content/_SharedTheme.css" rel="stylesheet" type="text/css" />

<h2>Delete Product</h2>
<h3>Are you sure you want to delete this product?</h3>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="form-horizontal">
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.product_name)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.product_name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.brand_name)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.brand_name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.category_name)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.category_name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.model_year)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.model_year)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.list_price)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.list_price)
        </dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.product_id)

        <div class="form-actions no-color">
            <input type="button" value="Back" class="btn btn-primary" onclick="history.back()" />
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    }
</div>

@model u24637646_HW03.Models.products
<link href="~/Content/_SharedTheme.css" rel="stylesheet" type="text/css" />
<div>
    <h4>Are you sure you want to delete this product ?</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.product_name)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.product_name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.brand_id)
        </dt>

        <dd>
            @* Note: Displays only the ID here. The full Delete page shows the name via ViewModel. *@
            @Html.DisplayFor(model => model.brand_id)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.category_id)
        </dt>

        <dd>
            @* Note: Displays only the ID here. The full Delete page shows the name via ViewModel. *@
            @Html.DisplayFor(model => model.category_id)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.model_year)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.model_year)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.list_price)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.list_price)
        </dd>
    </dl>

    @using (Html.BeginForm("DeleteConfirmed", "products", FormMethod.Post, new { id = "deleteCustomerForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.product_id)
<div class="form-actions no-color">
    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
    <input type="submit" value="Delete" class="btn btn-default" />
</div>
    }
</div>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Bike Store Application</title>


    <link rel="stylesheet" href="~/Content/bootstrap-grid.css" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" type="text/css" />


    <link rel="icon" type="image/png" href="@Url.Content("~/Images/BikeStore-Logo.png")">

    <link href="~/Content/_SharedTheme.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/_HomeStyles.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/_ReportingStyles.css" rel="stylesheet" type="text/css" />


    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>

    <div class="card-nav-container">
        <nav class="card-nav" style="background-color: var(--navbar-background);">

            @* Top section of the navigation (always visible). *@
            <div class="card-nav-top">
                @* Hamburger Menu icon/button to toggle the nav content. *@
                <div class="hamburger-menu"
                     role="button"
                     aria-label="Open menu"
                     tabindex="0"
                     style="color: var(--neutral-gray);">
                    <div class="hamburger-line"></div>
                    <div class="hamburger-line"></div>
                </div>

                @* Application Logo. *@
                <div class="logo-container">
                    <img src="~/Images/BikeStore-Logo.png" alt="Application Logo" class="logo" />
                </div>

                @* Call-to-Action button that links to the Home page. *@
                <button type="button"
                        class="card-nav-cta-button btn-info"
                        onclick="window.location.href='@Url.Action("Index", "Home")'">
                    Home
                </button>
            </div>

            @* Navigation content area that expands/collapses. *@
            <div class="card-nav-content" aria-hidden="true">
                @* Nav Card 1: System Links*@
                <div class="nav-card" style="background-color: var(--card-nav-dark-); color: #fff;">
                    <div class="nav-card-label">System</div>
                    <div class="nav-card-links">
                        <a class="nav-card-link" href="@Url.Action("Index", "Home")" aria-label="Go to the homepage">
                            <span class="nav-card-link-icon">↗</span>
                            Homepage
                        </a>
                        <a class="nav-card-link" href="@Url.Action("Maintain", "Home")">
                            <span class="nav-card-link-icon">↗</span>
                            Maintain
                        </a>
                        <a class="nav-card-link" href="@Url.Action("Reports", "Home")">
                            <span class="nav-card-link-icon">↗</span>
                            Reports
                        </a>
                    </div>
                </div>

                @* Nav Card 2: Raw Data (Staff, Customers, Products) *@
                <div class="nav-card" style="background-color: var(--card-nav-dark); color: #fff;">
                    <div class="nav-card-label">Raw Data</div>
                    <div class="nav-card-links">
                        <a class="nav-card-link" href="@Url.Action("Index", "staffs")">
                            <span class="nav-card-link-icon">↗</span>
                            Staff
                        </a>
                        <a class="nav-card-link" href="@Url.Action("Index", "customers")">
                            <span class="nav-card-link-icon">↗</span>
                            Customers
                        </a>
                        <a class="nav-card-link" href="@Url.Action("Index", "products")">
                            <span class="nav-card-link-icon">↗</span>
                            Products
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </div>

    <div class="container body-content" style="padding-top: 100px;">
        @RenderBody()
    </div>



    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    <script src="@Url.Content("~/Scripts/_LayoutScripts.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
@{
    ViewBag.Title = "Reports";
}

<link href="~/Content/_SharedTheme.css" rel="stylesheet" type="text/css" />

<!-- Place the first <script> tag in your HTML's <head> -->
<script src="https://cdn.tiny.cloud/1/ong4t6vwwpwhnn99x0emgdt7be7w0gn7dek4dil4h7xrps0i/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>

<body>

    <header class="header">
        <h1>Bike Stores Reporting</h1>
        <div class="sub-heading">
            @DateTime.Now.Date.ToString("MMMM dd, yyyy")
        </div>
    </header>


    <div class="dashboard-container">
        <div class="card">

            <div class="card-header">
                <h1 class="card-title">Monthly Order Trend</h1>
                <p class="sub-heading">Line Chart</p>
            </div>

            <div class="chart-canvas-container">
                <canvas id="monthlyLineChart"></canvas>
            </div>

            <div style="text-align: center; padding-top: 10px; padding-bottom: 10px;">
                <button id="StartLineChartButton" class="btn btn-success" type="button">Start Live Chart</button>
                <button id="StopLineChartButton" class="btn btn-danger" type="button">Stop Live Chart</button>

                <hr style="margin-top: 15px;" />

                @using (Html.BeginForm("SaveChartReport", "Home", FormMethod.Post, new { id = "lineChartForm", @class = "p-3 border rounded mx-auto", style = "max-width: 450px; text-align: left;" }))
                {
                    @Html.Hidden("ChartName", "Monthly Order Trend")
                    @Html.Hidden("Filetype", "PDF")
                    @* Hidden input for Base64 data (used by JS before submission) *@
                    <input type="hidden" name="PdfBase64Data" id="lineChartPdfBase64" />

                    <label for="lineChartFilename" class="form-label">File Name:</label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" id="lineChartFilename" name="Filename" required placeholder="e.g., Monthly_Orders_Q3" />
                        <span class="input-group-text">.PDF</span>
                    </div>

                    <label for="lineChartDescription" class="form-label">Description (Rich Text):</label>
                    <textarea id="lineChartDescription" name="Description" class="form-control mb-3"></textarea>

                    <br />
                    <div class="text-center">
                        <button type="submit" class="btn btn-secondary">Save Chart</button>
                    </div>
                }
            </div>
        </div>

        <div class="card">

            <div class="card-header">
                <h1 class="card-title">Sales Revenue Distribution</h1>
                <p class="sub-heading">Doughnut Chart</p>
            </div>

            <div class="chart-canvas-container">
                <canvas id="categoryDoughnutChart"></canvas>
            </div>

            <p class="chart-instruction">
                💡 Tip: Click on any store name in the legend above to temporarily hide/show that store's sales and compare the remaining totals.
            </p>

            <div style="text-align: center; padding-top: 10px; padding-bottom: 10px;">
                @using (Html.BeginForm("SaveChartReport", "Home", FormMethod.Post, new { id = "doughnutChartForm", @class = "p-3 border rounded mx-auto", style = "max-width: 450px; text-align: left;" }))
                {
                    @Html.Hidden("ChartName", "Sales Revenue Distribution")
                    @Html.Hidden("Filetype", "PDF")
                    @* Hidden input for Base64 data (used by JS before submission) *@
                    <input type="hidden" name="PdfBase64Data" id="doughnutChartPdfBase64" />

                    <label for="doughnutChartFilename" class="form-label">File Name:</label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" id="doughnutChartFilename" name="Filename" required placeholder="e.g., Store_Sales_Distribution" />
                        <span class="input-group-text">.PDF</span>
                    </div>

                    <label for="doughnutChartDescription" class="form-label">Description (Rich Text):</label>
                    <textarea id="doughnutChartDescription" name="Description" class="form-control mb-3"></textarea>

                    <br />
                    <div class="text-center">
                        <button type="submit" class="btn btn-secondary">Save Chart</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="archives-container">
        <div class="card">

            <div class="card-header">
                <h1 class="card-title">Document Archive</h1>
                <p class="sub-heading">Manage your saved chart reports</p>
            </div>

            <div class="card-body">

                @{
                    var reports = ViewBag.ArchivedReports as List<u24637646_HW03.Models.ArchivedReport>;
                }

                @if (reports != null && reports.Any())
                {
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>File Name</th>
                                <th>Chart Type</th>
                                <th>Date Saved</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in reports)
                            {
                                <tr>
                                    <td>@report.Filename</td>
                                    <td>@report.Filetype</td>
                                    <td>@report.DateSaved.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@Html.Raw(report.Description)</td>
                                    <td>
                                        <a href="@Url.Action("DownloadReport", "Home", new { filename = report.Filename, filetype = report.Filetype })" class="btn btn-sm btn-info me-2">Download</a>

                                        @using (Html.BeginForm("DeleteReport", "Home", FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.Hidden("filename", (string)report.Filename)
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this file?');">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info text-center" role="alert">
                        **No reports archived yet.** Save a chart using the forms above to see it appear here.
                    </div>
                }
            </div>
        </div>
    </div>
</body>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.12/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.12/vfs_fonts.js"></script>

    <script>
        // Define global variables to hold the JSON data
        window.lineLabels = @Html.Raw(ViewBag.LineLabels);
        window.lineData = @Html.Raw(ViewBag.LineData);
        window.DoughnutLabels = @Html.Raw(ViewBag.DoughnutLabels);
        window.DoughnutData = @Html.Raw(ViewBag.DoughnutData);
    </script>

    <script src="~/Scripts/_ReportingScripts.js"></script>

    <script>
        $(document).ready(function () {
            console.log('Document ready - initializing report functionality');

            // Track TinyMCE initialization
            let tinyMCEInitialized = 0;
            const totalEditors = 3;
            let tinyMCEAvailable = false;

            // Function to safely get content from textarea (with or without TinyMCE)
            function getEditorContent(editorId) {
                if (typeof tinymce !== 'undefined' && tinymce.get(editorId)) {
                    return tinymce.get(editorId).getContent();
                } else {
                    // Fallback to plain textarea value
                    return $('#' + editorId).val() || '';
                }
            }

            // Function to register form handlers (works with or without TinyMCE)
            function registerFormHandlers() {
                console.log('Registering form handlers...');

                // Intercept Monthly Line Chart Form Submission
                $('#lineChartForm').off('submit').on('submit', function (e) {
                    e.preventDefault();
                    console.log('Line Chart Form submitted');

                    const chartObject = window.monthlyLineChart;

                    if (!chartObject) {
                        alert("Error: Line Chart is not initialized. Please refresh the page.");
                        return false;
                    }

                    if (!chartObject.data || !chartObject.data.labels || chartObject.data.labels.length === 0) {
                        alert("Error: Line Chart has no data. Please run the live simulation first by clicking 'Start Live Chart'.");
                        return false;
                    }

                    try {
                        const chartTitle = $(this).find('input[name="ChartName"]').val();
                        const description = getEditorContent('lineChartDescription');

                        console.log('Chart Title:', chartTitle);
                        console.log('Description:', description.substring(0, 50) + '...');
                        console.log('Generating PDF for Line Chart...');

                        const docDefinition = window.getChartDocDef(chartTitle, chartObject, description);

                        pdfMake.createPdf(docDefinition).getBase64(function (base64Data) {
                            console.log('PDF generated successfully, Base64 length:', base64Data.length);

                            const cleanBase64 = base64Data.replace(/^data:application\/pdf;base64,/, '');

                            $('#lineChartPdfBase64').val(cleanBase64);
                            console.log('Submitting form with Base64 data (length: ' + cleanBase64.length + ')');

                            e.target.submit();
                        });
                    } catch (error) {
                        console.error('Error generating Line Chart PDF:', error);
                        alert('Error generating PDF: ' + error.message);
                        return false;
                    }
                });

                // Intercept Sales Doughnut Chart Form Submission
                $('#doughnutChartForm').off('submit').on('submit', function (e) {
                    e.preventDefault();
                    console.log('Doughnut Chart Form submitted');

                    const chartObject = window.categoryDoughnutChart;

                    if (!chartObject) {
                        alert("Error: Doughnut Chart is not initialized. Please refresh the page.");
                        return false;
                    }

                    if (!chartObject.data || !chartObject.data.datasets || chartObject.data.datasets.length === 0) {
                        alert("Error: Doughnut Chart has no data. Please wait for the chart to load.");
                        return false;
                    }

                    try {
                        const chartTitle = $(this).find('input[name="ChartName"]').val();
                        const description = getEditorContent('doughnutChartDescription');

                        console.log('Chart Title:', chartTitle);
                        console.log('Description:', description.substring(0, 50) + '...');
                        console.log('Generating PDF for Doughnut Chart...');

                        const docDefinition = window.getChartDocDef(chartTitle, chartObject, description);

                        pdfMake.createPdf(docDefinition).getBase64(function (base64Data) {
                            console.log('PDF generated successfully, Base64 length:', base64Data.length);

                            const cleanBase64 = base64Data.replace(/^data:application\/pdf;base64,/, '');

                            $('#doughnutChartPdfBase64').val(cleanBase64);
                            console.log('Submitting form with Base64 data (length: ' + cleanBase64.length + ')');

                            e.target.submit();
                        });
                    } catch (error) {
                        console.error('Error generating Doughnut Chart PDF:', error);
                        alert('Error generating PDF: ' + error.message);
                        return false;
                    }
                });

                console.log('Form handlers registered successfully');
            }

            // Try to initialize TinyMCE, but don't depend on it
            if (typeof tinymce !== 'undefined') {
                console.log('TinyMCE is available, initializing...');
                tinyMCEAvailable = true;

                tinymce.init({
                    selector: '#lineChartDescription, #doughnutChartDescription, #reportDescriptionModal',
                    plugins: 'autoresize link image lists',
                    toolbar: 'undo redo | formatselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image',
                    menubar: false,
                    autoresize_bottom_margin: 16,
                    min_height: 150,
                    max_height: 500,
                    setup: function (editor) {
                        editor.on('init', function () {
                            tinyMCEInitialized++;
                            console.log('TinyMCE editor initialized:', editor.id, '(' + tinyMCEInitialized + '/' + totalEditors + ')');

                            if (tinyMCEInitialized === totalEditors) {
                                console.log('All TinyMCE editors initialized.');
                                registerFormHandlers();
                            }
                        });
                    }
                });

                // Fallback: if TinyMCE takes too long, register handlers anyway
                setTimeout(function () {
                    if (tinyMCEInitialized < totalEditors) {
                        console.warn('TinyMCE initialization timeout. Registering handlers without TinyMCE.');
                        registerFormHandlers();
                    }
                }, 3000);
            } else {
                console.warn('TinyMCE is not available. Using plain textareas. Registering handlers...');
                // Register form handlers immediately if TinyMCE isn't available
                registerFormHandlers();
            }

            // Modal logic for editing archives
            $('#descriptionModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var filename = button.data('filename');
                var description = button.data('description');
                var modal = $(this);

                modal.find('#modal-filename').text(filename);
                modal.find('#modal-hidden-filename').val(filename);

                setTimeout(function () {
                    if (typeof tinymce !== 'undefined' && tinymce.get('reportDescriptionModal')) {
                        tinymce.get('reportDescriptionModal').setContent(description || '');
                        console.log('Modal TinyMCE content set for:', filename);
                    } else {
                        $('#reportDescriptionModal').val(description || '');
                        console.log('Modal textarea content set for:', filename);
                    }
                }, 150);
            });

            tinymce.init({
                selector: 'textarea',
                plugins: [
                    // Core editing features
                    'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount',
                    // Your account includes a free trial of TinyMCE premium features
                    // Try the most popular premium features until Nov 16, 2025:
                    'checklist', 'mediaembed', 'casechange', 'formatpainter', 'pageembed', 'a11ychecker', 'tinymcespellchecker', 'permanentpen', 'powerpaste', 'advtable', 'advcode', 'advtemplate', 'ai', 'uploadcare', 'mentions', 'tinycomments', 'tableofcontents', 'footnotes', 'mergetags', 'autocorrect', 'typography', 'inlinecss', 'markdown', 'importword', 'exportword', 'exportpdf'
                ],
                toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link media table mergetags | addcomment showcomments | spellcheckdialog a11ycheck typography uploadcare | align lineheight | checklist numlist bullist indent outdent | emoticons charmap | removeformat',
                tinycomments_mode: 'embedded',
                tinycomments_author: 'Author name',
                mergetags_list: [
                    { value: 'First.Name', title: 'First Name' },
                    { value: 'Email', title: 'Email' },
                ],
                ai_request: (request, respondWith) => respondWith.string(() => Promise.reject('See docs to implement AI Assistant')),
                uploadcare_public_key: '0f66733de1782e01cf31',
            });
        });
    </script>
}
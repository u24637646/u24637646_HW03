@model u24637646_HW03.ViewModels.MaintainViewModel

@{
    ViewBag.Title = "Maintain Records";
}

<link href="~/Content/_SharedTheme.css" rel="stylesheet" type="text/css" />

<div class="body">

    <header>
        <h1><i class="glyphicon glyphicon-wrench"></i>Maintain Dashboard</h1>
    </header>

    @* Success/Error Message Display (Crucial for showing results after modal submission) *@
    @if (TempData["Message"] != null)
    {
        var alertClass = TempData["MessageClass"] ?? "alert-success";
        <div class="alert @alertClass alert-dismissible" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            @Html.Raw(TempData["Message"])
        </div>
    }

    <script>
        // CRITICAL: Initialize global map objects for quick lookup/current ID tracking
        var entityDataMap = entityDataMap || {};
        var currentDisplayId = { 'staff': 0, 'customer': 0, 'product': 0 };
    </script>

    <div class="row dashboard-row">

        @* ------------------------------------------------------------------ *@
        @* --- Staff Panel --- *@
        @* ------------------------------------------------------------------ *@
        <div class="col-md-4">
            <div class="panel panel-success dashboard-panel">
                <div class="panel-heading maintain-heading">
                    <h3 class="panel-title"><i class="glyphicon glyphicon-user"></i> Staff</h3>

                    @* Dropdown Selector *@
                    <select id="staff-name-selector" class="form-control-select select-name" onchange="selectEntityByName(this, 'staff')">
                        <option value="0">--- Select ---</option>
                        @if (Model.StaffsList != null)
                        {
                            foreach (var staff in Model.StaffsList.OrderBy(s => s.last_name))
                            {
                                <option value="@staff.staff_id">@staff.first_name @staff.last_name</option>
                            }
                        }
                    </select>
                </div>

                <div class="panel-body text-center">
                    @if (Model.StaffsList != null && Model.StaffsList.Any())
                    {
                        var initialStaff = Model.StaffsList.OrderBy(s => s.last_name).First();

                        @* CRITICAL: Serialize all Staff data into JavaScript for client-side search/display updates *@
                        <script>
                            entityDataMap['staff'] = entityDataMap['staff'] || {};
                            // Use C# to generate a JSON array, then map it in JS to avoid serialization issues
                            var rawStaffs = @Html.Raw(Json.Encode(Model.StaffsList.Select(s => new {
                                id = s.staff_id,
                                name = s.first_name + " " + s.last_name,
                                email = s.email,
                                phone = s.phone,
                                store = s.store_name,
                                manager = s.manager_name
                            })));

                            rawStaffs.forEach(function(item) {
                                entityDataMap['staff'][item.id] = item;
                            });

                            currentDisplayId['staff'] = @initialStaff.staff_id; // Set initial ID for pre-selection
                        </script>

                        @* Single container for dynamic detail content, populated by JS on load *@
                        <div id="staff-detail-container">
                            <p class="text-info">Select a staff record or use the search box.</p>
                        </div>
                        @* Hidden input to track the currently displayed record ID for Edit/Delete actions *@
                        <input type="hidden" id="staff-current-id" value="@initialStaff.staff_id" />
                    }
                    else
                    {
                        <div id="staff-detail-container">
                            <p class="text-danger">No staff records found.</p>
                        </div>
                        <input type="hidden" id="staff-current-id" value="0" />
                    }
                </div>

                @* Panel Footer: Search and Action Buttons *@
                <div class="panel-footer staff-navigator panel-navigator text-center">
                    <div class="input-group input-group-sm search-group">
                        <input id="staff-search-input" type="text" class="form-control text-center rounded" placeholder="--- Search Name/ID ---" />
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button" onclick="filterAndDisplay('staff')">
                                <i class="glyphicon glyphicon-search">>>></i>
                            </button>
                        </span>
                    </div>

                    <div class="btn-group btn-group-sm maintenance-actions" role="group">
                        <button type="button" class="btn btn-warning" onclick="loadMaintenanceModal('staff', 'Edit')">
                            Edit
                        </button>
                        <button type="button" class="btn btn-danger" onclick="confirmAndDelete('staff')">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* ------------------------------------------------------------------ *@
        @* --- Customer Panel --- *@
        @* ------------------------------------------------------------------ *@
        <div class="col-md-4">
            <div class="panel panel-info dashboard-panel">
                <div class="panel-heading maintain-heading">
                    <h3 class="panel-title"><i class="glyphicon glyphicon-globe"></i> Customer</h3>
                    @* Dropdown Selector *@
                    <select id="customer-name-selector" class="form-control-select select-name" onchange="selectEntityByName(this, 'customer')">
                        <option value="0">--- Select ---</option>
                        @if (Model.CustomersList != null)
                        {
                            foreach (var customer in Model.CustomersList.OrderBy(c => c.last_name))
                            {
                                <option value="@customer.customer_id">@customer.first_name @customer.last_name</option>
                            }
                        }
                    </select>
                </div>
                <div class="panel-body text-center">
                    @if (Model.CustomersList != null && Model.CustomersList.Any())
                    {
                        var initialCustomer = Model.CustomersList.OrderBy(c => c.last_name).First();

                        @* CRITICAL: Serialize all Customer data into JavaScript for client-side search/display updates *@
                        <script>
                            entityDataMap['customer'] = entityDataMap['customer'] || {};
                            var rawCustomers = @Html.Raw(Json.Encode(Model.CustomersList.Select(c => new {
                                id = c.customer_id,
                                name = c.first_name + " " + c.last_name,
                                email = c.email,
                                phone = c.phone,
                                city = c.city,
                                state = c.state,
                                street = c.street,
                                zip = c.zip_code
                            })));

                            rawCustomers.forEach(function(item) {
                                entityDataMap['customer'][item.id] = item;
                            });

                            currentDisplayId['customer'] = @initialCustomer.customer_id; // Set initial ID for pre-selection
                        </script>

                        @* Single container for dynamic detail content, populated by JS on load *@
                        <div id="customer-detail-container">
                            <p class="text-info">Select a customer record or use the search box.</p>
                        </div>
                        @* Hidden input to track the currently displayed record ID for Edit/Delete actions *@
                        <input type="hidden" id="customer-current-id" value="@initialCustomer.customer_id" />
                    }
                    else
                    {
                        <div id="customer-detail-container">
                            <p class="text-danger">No customer records found.</p>
                        </div>
                        <input type="hidden" id="customer-current-id" value="0" />
                    }
                </div>

                <div class="panel-footer customer-navigator panel-navigator text-center">
                    <div class="input-group input-group-sm search-group">
                        <input id="customer-search-input" type="text" class="form-control text-center rounded" placeholder="--- Search Name/ID ---" />
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button" onclick="filterAndDisplay('customer')">
                                <i class="glyphicon glyphicon-search">>>></i>
                            </button>
                        </span>
                    </div>

                    <div class="btn-group btn-group-sm maintenance-actions" role="group">
                        <button type="button" class="btn btn-warning" onclick="loadMaintenanceModal('customer', 'Edit')">
                            Edit
                        </button>
                        <button type="button" class="btn btn-danger" onclick="confirmAndDelete('customer')">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* ------------------------------------------------------------------ *@
        @* --- Product Panel --- *@
        @* ------------------------------------------------------------------ *@
        <div class="col-md-4">
            <div class="panel panel-warning dashboard-panel">
                <div class="panel-heading maintain-heading">
                    <h3 class="panel-title"><i class="glyphicon glyphicon-tag"></i> Product </h3>
                    @* Dropdown Selector *@
                    <select id="product-name-selector" class="form-control-select select-name" onchange="selectEntityByName(this, 'product')">
                        <option value="0">--- Select ---</option>
                        @if (Model.ProductsList != null)
                        {
                            foreach (var product in Model.ProductsList.OrderBy(p => p.product_name))
                            {
                                <option value="@product.product_id">@product.product_name</option>
                            }
                        }
                    </select>

                </div>
                <div class="panel-body text-center">

                    @if (Model.ProductsList != null && Model.ProductsList.Any())
                    {
                        var initialProduct = Model.ProductsList.OrderBy(p => p.product_name).First();

                        @* CRITICAL: Serialize all Product data into JavaScript for client-side search/display updates *@
                        <script>
                            entityDataMap['product'] = entityDataMap['product'] || {};

                            // Re-calculate the image URL for all products during serialization
                            var rawProducts = @Html.Raw(Json.Encode(Model.ProductsList.Select(p => new {
                                id = p.product_id,
                                name = p.product_name,
                                brand = p.brand_name,
                                category = p.category_name,
                                year = p.model_year,
                                price = p.list_price.ToString("C"),
                                stock = p.TotalStock,
                                // Calculate URL here using C# Url.Content helper
                                imageUrl = Url.Content("~/Images/" + p.brand_name.Split(' ')[0] + "1.jpeg")
                            })));

                            rawProducts.forEach(function(item) {
                                entityDataMap['product'][item.id] = item;
                            });

                            currentDisplayId['product'] = @initialProduct.product_id; // Set initial ID for pre-selection
                        </script>

                        @* Single container for dynamic detail content, populated by JS on load *@
                        <div id="product-detail-container">
                            <p class="text-info">Select a product record or use the search box.</p>
                        </div>
                        @* Hidden input to track the currently displayed record ID for Edit/Delete actions *@
                        <input type="hidden" id="product-current-id" value="@initialProduct.product_id" />
                    }
                    else
                    {
                        <div id="product-detail-container">
                            <p class="text-danger">No product records found.</p>
                        </div>
                        <input type="hidden" id="product-current-id" value="0" />
                    }
                </div>

                <div class="panel-footer product-navigator panel-navigator text-center">
                    <div class="input-group input-group-sm search-group">
                        <input id="product-search-input" type="text" class="form-control text-center rounded" placeholder="--- Search Name/ID ---" />
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button" onclick="filterAndDisplay('product')">
                                <i class="glyphicon glyphicon-search">>>></i>
                            </button>
                        </span>
                    </div>

                    <div class="btn-group btn-group-sm maintenance-actions" role="group" style="justify-content: space-between">
                        <button type="button" class="btn btn-warning" onclick="loadMaintenanceModal('product', 'Edit')">
                            Edit
                        </button>
                        <button type="button" class="btn btn-danger" onclick="confirmAndDelete('product')">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- Maintenance Modals (Placeholders for AJAX content) --- *@
    <div class="modal fade" id="maintainStaffModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="maintainStaffModalTitle">Staff Maintenance</h4>
                </div>
                <div class="modal-body" id="maintainStaffModalBody">
                    @* Staff maintenance/edit partial view content will load here via AJAX *@
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="maintainCustomerModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="maintainCustomerModalTitle">Customer Maintenance</h4>
                </div>
                <div class="modal-body" id="maintainCustomerModalBody">
                    @* Customer maintenance/edit partial view content will load here via AJAX *@
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="maintainProductModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="maintainProductModalTitle">Product Maintenance</h4>
                </div>
                <div class="modal-body" id="maintainProductModalBody">
                    @* Product maintenance/edit partial view content will load here via AJAX *@
                </div>
            </div>
        </div>
    </div>

</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @* This is the critical script that drives the maintenance logic *@
    <script src="@Url.Content("~/Scripts/_MaintainScripts.js")"></script>

    @* 🚀 Initialization Script: Calls updatePanelDisplay to show the first record after the page loads and the data map is populated. *@
    <script>
        $(document).ready(function () {
            // Loop through all defined entities to display the initial item
            ['staff', 'customer', 'product'].forEach(function (entity) {
                var currentId = currentDisplayId[entity];

                // Only attempt to display if there is a valid initial ID set by C#
                if (currentId > 0 && entityDataMap[entity] && entityDataMap[entity][currentId]) {
                    // Call the JS function to render the initial details using the first record's data
                    updatePanelDisplay(entity, entityDataMap[entity][currentId]);
                    // Also update the dropdown to match the selected item
                    $('#' + entity + '-name-selector').val(currentId);
                }
            });
        });
    </script>
}
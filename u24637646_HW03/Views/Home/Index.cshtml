                            <p> /@(Model.ProductsList.Count())</p>
                        </div>
                    </div>

                    <div class="btn-group btn-group-sm" role="group" style="margin-top: 5px;">
                        <button type="button" class="btn btn-warning" onclick="navigate('product', -1)">

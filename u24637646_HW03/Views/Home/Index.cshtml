@model u24637646_HW03.ViewModels.HomeIndexViewModel

@{
    ViewBag.Title = "Home";
}
<link href="~/Content/_SharedTheme.css" rel="stylesheet" type="text/css" />

<div class="body">

    <header>
        <h1>Bike Stores Dashboard</h1>
    </header> 

    @* Success Message Display (using TempData set in the controller) *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            @Html.Raw(TempData["SuccessMessage"])
        </div>
    }

    @* === START PRODUCT FILTER FORM === *@
    @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "product-filter-form" }))
    {
   
        <div class="product-filter-container">

            @{
                // Get the lists and selected values from ViewData (Set by the Controller)
                var allBrands = ViewData["AllBrands"] as List<string> ?? new List<string>();
                var allCategories = ViewData["AllCategories"] as List<string> ?? new List<string>();

                var selectedBrand = ViewData["SelectedBrand"] as string;
                var selectedCategory = ViewData["SelectedCategory"] as string;
            }

            @* --- Brand Dropdown --- *@
            @* INLINE STYLE MOVED TO CSS ID #brand-filter *@
            <select id="brand-filter" name="selectedBrand" class="form-control">
                <option value="" @(string.IsNullOrEmpty(selectedBrand) ? "selected" : "")>All Brands</option>
                @foreach (var brand in allBrands)
                {
                    <option value="@brand" @(brand == selectedBrand ? "selected" : "")>@brand</option>
                }
            </select>

            @* --- Category Dropdown --- *@
            @* INLINE STYLE MOVED TO CSS ID #category-filter *@
            <select id="category-filter" name="selectedCategory" class="form-control">
                <option value="" @(string.IsNullOrEmpty(selectedCategory) ? "selected" : "")>All Categories</option>
                @foreach (var category in allCategories)
                {
                    <option value="@category" @(category == selectedCategory ? "selected" : "")>@category</option>
                }
            </select>

            @* INLINE STYLE MOVED TO CSS SELECTOR .product-filters > div:nth-child(3) *@
            <div>
                <a href="@Url.Action("Index", "Home")" class="btn btn-default btn-sm btn-block">Reset Filter</a>
            </div>
        </div>

    }
    @* === END PRODUCT FILTER FORM === *@

    <script>
        var entityIdMap = entityIdMap || {};
    </script>

    @* INLINE STYLE MOVED TO CSS CLASS .dashboard-row *@
    <div class="row dashboard-row">
        @*--- Staff Panel ---*@
        <div class="col-md-4">
            <div class="panel panel-success dashboard-panel">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="glyphicon glyphicon-user"></i> Staff</h3>
                    <button type="button" id="createStaffBtn" class="btn btn-info btn-xs pull-right" data-toggle="modal" data-target="#createStaffModal">
                        Create
                    </button>
                </div>
                <div class="panel-body text-center" id="staff-panel-body">
                    @if (Model.StaffsList != null && Model.StaffsList.Any())
                    {
                        <input type="hidden" id="staff-index" value="0" />

                        for (int i = 0; i < Model.StaffsList.Count(); i++)
                        {
                            var staff = Model.StaffsList.ElementAt(i);

                            @* CRITICAL: Entity ID Mapping for jumpToId function (Must remain) *@
                            <script>
                                entityIdMap['staff'] = entityIdMap['staff'] || {};
                                entityIdMap['staff'][@staff.staff_id] = @i;
                            </script>

                            @* DISPLAY LOGIC MUST REMAIN IN RAZOR *@
                            <div class="detail-item staff-item" id="staff-@i" data-staff-id="@staff.staff_id" style="display: @(i == 0 ? "block" : "none");">
                                <h4 class="text-center">@staff.first_name @staff.last_name</h4>
                                <p>Email: @staff.email</p>
                                <p>Phone: @staff.phone</p>
                                <p>Store: @staff.store_name</p>
                                <p>Manager: @staff.manager_name</p>
                                <br />
                                <hr />
                                <h5>Recent Sales:</h5>
                                <ul class="list-unstyled sales-list">
                                    @{
                                        var staffSales = Model.StaffSalesList
                                            .Where(s => s.staff_id == staff.staff_id).Take(5);
                                    }
                                    @if (staffSales.Any())
                                    {
                                        foreach (var sale in staffSales)
                                        {
                                            <li>Sold: @sale.product_name </li>
                                        }
                                    }
                                    else
                                    {
                                        <li>No recent sales recorded.</li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-danger">No staff records found.</p>
                    }
                </div>
                <div class="panel-footer staff-navigator panel-navigator text-center">
                    @if (Model.StaffsList != null && Model.StaffsList.Any())
                    {
                        <div class="id-jump-container">
                            <div class="input-group input-group-sm mb-2 id-input-group">
                                <input id="staff-id-jump"
                                       type="number"
                                       class="panel-nav form-control text-center"
                                       min="1"
                                       placeholder="@(Model.StaffsList.First().staff_id)"
                                       onchange="jumpToId('staff')"
                                       onkeypress="if(event.keyCode == 13) { jumpToId('staff'); return false; }" />
                            </div>
                            <p> /@(Model.StaffsList.Count())</p>
                        </div>
                        @* INLINE STYLE MOVED TO CSS SELECTOR .panel-navigator .btn-group *@
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-info" onclick="navigate('staff', -1)">
                                <i class="glyphicon glyphicon-chevron-left"><</i>
                            </button>
                            @Html.ActionLink("View Details", "Details", "Staffs",
                                new { id = Model.StaffsList.First().staff_id },
                                new { @class = "btn btn-info", @id = "staff-details-link" })
                            <button type="button" class="btn btn-info" onclick="navigate('staff', 1)">
                                <i class="glyphicon glyphicon-chevron-right">></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        @Html.ActionLink("View All Staff", "Index", "Staffs", null, new { @class = "btn btn-success btn-info" })
                    }
                </div>
            </div>
        </div>

        @*--- Customer Panel ---*@
        <div class="col-md-4">
            <div class="panel panel-info dashboard-panel">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="glyphicon glyphicon-globe"></i> Customers</h3>
                    <button type="button" id="createCustomerBtn" class="btn btn-info btn-xs pull-right" data-toggle="modal" data-target="#createCustomerModal">
                        Create
                    </button>
                </div>
                <div class="panel-body text-center" id="customer-panel-body">
                    @if (Model.CustomersList != null && Model.CustomersList.Any())
                    {
                        <input type="hidden" id="customer-index" value="0" />

                        for (int i = 0; i < Model.CustomersList.Count(); i++)
                        {
                            var customer = Model.CustomersList.ElementAt(i);

                            @* CRITICAL: Entity ID Mapping for jumpToId function (Must remain) *@
                            <script>
                                entityIdMap['customer'] = entityIdMap['customer'] || {};
                                entityIdMap['customer'][@customer.customer_id] = @i;
                            </script>

                            @* DISPLAY LOGIC MUST REMAIN IN RAZOR *@
                            <div class="detail-item customer-item" id="customer-@i" data-customer-id="@customer.customer_id" style="display: @(i == 0 ? "block" : "none");">
                                <h4 class="text-center"> @customer.first_name @customer.last_name</h4>
                                <p>Email: @customer.email</p>
                                <p>Phone: @customer.phone</p>
                                <p>Location: @customer.city, @customer.state</p>
                                <p>Street: @customer.street</p>
                                <p>Zip: @customer.zip_code</p>
                                <hr />
                                <h5>Recent Purchases:</h5>
                                <ul class="list-unstyled sales-list">
                                    @{
                                        var customerPurchases = Model.CustomerPurchasesList
                                        .Where(p => p.customer_id == customer.customer_id).Take(5);
                                    }
                                    @if (customerPurchases.Any())
                                    {
                                        foreach (var purchase in customerPurchases)
                                        {
                                            <li>Purchased: @purchase.product_name</li>
                                        }
                                    }
                                    else
                                    {
                                        <li>No recent purchases recorded.</li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-danger">No customer records found.</p>
                    }
                </div>
                <div class="panel-footer customer-navigator panel-navigator text-center">
                    @if (Model.CustomersList != null && Model.CustomersList.Any())
                    {
                        <div class="id-jump-container">
                            <div class="input-group input-group-sm mb-2 id-input-group">
                                <input id="customer-id-jump"
                                       type="number"
                                       class="panel-nav form-control text-center"
                                       min="1"
                                       placeholder="@(Model.CustomersList.First().customer_id)"
                                       onchange="jumpToId('customer')"
                                       onkeypress="if(event.keyCode == 13) { jumpToId('customer'); return false; }" />
                            </div>
                            <p> /@(Model.CustomersList.Count())</p>
                        </div>
                        @* INLINE STYLE MOVED TO CSS SELECTOR .panel-navigator .btn-group *@
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-info" onclick="navigate('customer', -1)">
                                <i class="glyphicon glyphicon-chevron-left"><</i>
                            </button>
                            @Html.ActionLink("View Details", "Details", "Customers",
                                new { id = Model.CustomersList.First().customer_id },
                                new { @class = "btn btn-info", @id = "customer-details-link" })
                            <button type="button" class="btn btn-info" onclick="navigate('customer', 1)">
                                <i class="glyphicon glyphicon-chevron-right">></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        @Html.ActionLink("View All Customers", "Index", "Customers", null, new { @class = "btn btn-info btn-block" })
                    }
                </div>
            </div>
        </div>


        @*--- Products Panel (FIXED - Mapped) ---*@
        <div class="col-md-4">
            <div class="panel panel-warning dashboard-panel">

                <div class="panel-heading">
                    <h3 class="panel-title"><i class="glyphicon glyphicon-tag"></i> Products </h3>
                </div>

                <div class="panel-body text-center" id="product-panel-body">
                    @if (Model.ProductsList != null && Model.ProductsList.Any())
                    {
                        <input type="hidden" id="product-index" value="0" />

                        for (int i = 0; i < Model.ProductsList.Count(); i++)
                        {
                            var product = Model.ProductsList.ElementAt(i);
                            var brandBaseName = product.brand_name.Split(' ')[0];
                            var randomImageSuffix = (i % 2) + 1;
                            var imageUrl = Url.Content("~/Images/" + brandBaseName + randomImageSuffix + ".jpeg");

                            @* CRITICAL FIX: Entity ID Mapping for jumpToId function (Must remain) *@
                            <script>
                                entityIdMap['product'] = entityIdMap['product'] || {};
                                entityIdMap['product'][@product.product_id] = @i;
                            </script>

                            @* DISPLAY LOGIC MUST REMAIN IN RAZOR *@
                            <div class="detail-item product-item"
                                 id="product-@i"
                                 data-product-id="@product.product_id"
                                 data-brand="@product.brand_name"
                                 data-category="@product.category_name"
                                 style="display:@(i == 0 ? "block" : "none")">

                                <h4 class="text-center">@product.product_name</h4>

                                @* INLINE STYLE MOVED TO CSS SELECTOR .product-item img *@
                                <img src="@imageUrl"
                                     alt="Image of @product.product_name" />

                                <p>Brand: @product.brand_name</p>
                                <p>Category: @product.category_name</p>
                                <p>Model Year: @product.model_year</p>
                                <p>Price: @product.list_price.ToString("C")</p>
                                <p>Total Stock: @product.TotalStock</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-danger">No product records found matching your filters.</p>
                    }
                </div>

                <div class="panel-footer product-navigator panel-navigator text-center">
                    @if (Model.ProductsList != null && Model.ProductsList.Any())
                    {
                        @* Navigation controls *@
                        <div class="id-jump-container">
                            <div class="input-group input-group-sm mb-2 id-input-group">
                                <input id="product-id-jump"
                                       type="number"
                                       class="panel-nav form-control text-center"
                                       min="1"
                                       placeholder="@(Model.ProductsList.First().product_id)"
                                       onchange="jumpToId('product')"
                                       onkeypress="if(event.keyCode == 13) { jumpToId('product'); return false; }" />
                            </div>
                            <p> /@(Model.ProductsList.Count())</p>
                        </div>

                        @* INLINE STYLE MOVED TO CSS SELECTOR .panel-navigator .btn-group *@
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-info" onclick="navigate('product', -1)">
                                <i class="glyphicon glyphicon-chevron-left"><</i>
                            </button>

                            @Html.ActionLink("View Details", "Details", "Products",
                                new { id = Model.ProductsList.First().product_id },
                                new { @class = "btn btn-info", @id = "product-details-link" })

                            <button type="button" class="btn btn-info" onclick="navigate('product', 1)">
                                <i class="glyphicon glyphicon-chevron-right">></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        @Html.ActionLink("View All Products", "Index", "Products", null, new { @class = "btn btn-info btn-block" })
                    }
                </div>
            </div>
        </div>
    </div>

    @*--- Modal Staff Popups ---*@
    <div class="modal fade" id="createStaffModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-body" id="staffModalBody">
                    @* Partial view content will load here via AJAX *@
                </div>
            </div>
        </div>
    </div>

    @*--- Modal Customers Popups ---*@
    <div class="modal fade" id="createCustomerModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-body" id="customerModalBody">
                    @* Partial view content will load here via AJAX *@
                </div>
            </div>
        </div>
    </div>

</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @* Include the external script file containing navigate() and jumpToId() *@
    <script src="@Url.Content("~/Scripts/_IndexScripts.js")"></script>
}
@model u24637646_HW03.Models.staffs

<link href="~/Content/_DataStyleSheet.css" rel="stylesheet" type="text/css" />
@* NOTE: This partial view assumes the model has related entities (stores, staffs2) loaded via Include() in the controller if you are displaying properties like store_name.
    If not, you should use a ViewModel that includes the string properties, or ensure the loading action is robust.
*@
<div>
    <h4>Are you sure you want to delete this staff member?</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.first_name)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.first_name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.last_name)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.last_name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.email)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.email)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.phone)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.phone)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.active)
        </dt>
        <dd>
            @(Model.active == 1 ? "Yes" : "No")
        </dd>

        @* Displaying related data (Manager Name, Store Name) - requires eager loading in the controller *@
        <dt>
            @Html.DisplayNameFor(model => model.stores.store_name)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.stores.store_name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.staffs2.first_name) Manager
        </dt>
        <dd>
            @if (Model.manager_id.HasValue)
            {
                @Html.DisplayFor(model => model.staffs2.first_name) @Html.DisplayFor(model => model.staffs2.last_name)
            }
            else
            {
                <span>No Manager</span>
            }
        </dd>
    </dl>

    @using (Html.BeginForm("DeleteConfirmed", "customers", FormMethod.Post, new { id = "deleteCustomerForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.staff_id)
<div class="form-actions no-color">
    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
    <input type="submit" value="Delete" class="btn btn-default" />
</div>
    }

</div>

